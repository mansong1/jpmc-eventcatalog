# Runtime-only image for a catalog built somewhere else (the developer's Mac, in the `laptop_preview` pipeline).
# Same runtime stage as ./Dockerfile; the context is a bundle dir holding dist/ and nginx.conf, not the repo:
#   docker build -f Dockerfile.static --build-arg BUILD_LABEL=<label> <bundle dir>
FROM nginx:1.29-alpine
# patched OS packages: the RC image gate (AquaTrivy, fail on critical) blocked rc-6fadf36 on alpine libs in the base
RUN apk upgrade --no-cache
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html/
ARG BUILD_LABEL=""
RUN printf '{"build":"%s"}\n' "${BUILD_LABEL}" > /usr/share/nginx/html/version.json
EXPOSE 80
