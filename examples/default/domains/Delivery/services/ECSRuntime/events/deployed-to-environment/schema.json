{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeployedToEnvironment",
  "type": "object",
  "properties": {
    "env": {
      "type": "string",
      "enum": [
        "jpmc_dev",
        "jpmc_staging",
        "jpmc_prod"
      ]
    },
    "imageTag": {
      "type": "string"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "rolling",
        "blue_green",
        "canary"
      ]
    },
    "url": {
      "type": "string"
    },
    "deployedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "env",
    "imageTag",
    "strategy",
    "deployedAt"
  ]
}
