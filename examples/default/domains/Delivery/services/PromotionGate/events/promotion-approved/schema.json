{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromotionApproved",
  "type": "object",
  "properties": {
    "fromEnv": {
      "type": "string",
      "enum": [
        "jpmc_dev",
        "jpmc_staging",
        "jpmc_prod"
      ]
    },
    "toEnv": {
      "type": "string",
      "enum": [
        "jpmc_dev",
        "jpmc_staging",
        "jpmc_prod"
      ]
    },
    "imageTag": {
      "type": "string",
      "pattern": "^rc-[0-9a-f]+$",
      "description": "Immutable release-candidate tag, rc-<sha>"
    },
    "servedTag": {
      "type": "string",
      "description": "build read from the previous env's /version.json"
    },
    "soakSeconds": {
      "type": "integer"
    },
    "minSoakSeconds": {
      "type": "integer",
      "enum": [
        0,
        180
      ]
    }
  },
  "required": [
    "fromEnv",
    "toEnv",
    "imageTag",
    "servedTag",
    "soakSeconds",
    "minSoakSeconds"
  ]
}
