{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromotionDenied",
  "type": "object",
  "properties": {
    "fromEnv": {
      "type": "string",
      "enum": [
        "jpmc_dev",
        "jpmc_staging",
        "jpmc_prod"
      ]
    },
    "toEnv": {
      "type": "string",
      "enum": [
        "jpmc_dev",
        "jpmc_staging",
        "jpmc_prod"
      ]
    },
    "imageTag": {
      "type": "string",
      "pattern": "^rc-[0-9a-f]+$",
      "description": "Immutable release-candidate tag, rc-<sha>"
    },
    "servedTag": {
      "type": "string",
      "description": "build read from the previous env's /version.json"
    },
    "soakSeconds": {
      "type": "integer"
    },
    "minSoakSeconds": {
      "type": "integer",
      "enum": [
        0,
        180
      ]
    },
    "denyMessages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OPA deny reasons, e.g. tag is not rc-<sha>, previous env serves another build, soak below minimum"
    }
  },
  "required": [
    "fromEnv",
    "toEnv",
    "imageTag",
    "denyMessages"
  ]
}
