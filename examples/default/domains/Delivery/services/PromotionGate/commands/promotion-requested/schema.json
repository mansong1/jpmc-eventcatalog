{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromotionRequested",
  "type": "object",
  "properties": {
    "fromEnv": {
      "type": "string",
      "enum": [
        "jpmc_dev",
        "jpmc_staging",
        "jpmc_prod"
      ]
    },
    "toEnv": {
      "type": "string",
      "enum": [
        "jpmc_dev",
        "jpmc_staging",
        "jpmc_prod"
      ]
    },
    "imageTag": {
      "type": "string",
      "pattern": "^rc-[0-9a-f]+$",
      "description": "Immutable release-candidate tag, rc-<sha>"
    },
    "approvalType": {
      "type": "string",
      "enum": [
        "manual",
        "change_window"
      ]
    },
    "approver": {
      "type": "string"
    }
  },
  "required": [
    "fromEnv",
    "toEnv",
    "imageTag",
    "approvalType"
  ]
}
